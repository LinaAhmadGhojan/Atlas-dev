DirectoryIndex index.html default.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L,QSA]

  RewriteCond %{THE_REQUEST} \s/+default\.html[\s?] [NC]
  RewriteRule ^default\.html$ / [R=301,L,QSA]
</IfModule>
